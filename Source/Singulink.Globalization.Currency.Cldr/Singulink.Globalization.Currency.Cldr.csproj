<Project Sdk="Microsoft.NET.Sdk">
  <!-- The package version is derived from the CLDR version the data was generated from. See Cldr.Version.props (generated by Tools/CldrDataGenerator). -->
  <Import Project="Cldr.Version.props" />

  <PropertyGroup>
    <RootNamespace>Singulink.Globalization</RootNamespace>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>

    <Version Condition="'$(CldrPackageRevision)' == '0'">$(CldrVersion)</Version>
    <Version Condition="'$(CldrPackageRevision)' != '0'">$(CldrVersion).$(CldrPackageRevision)</Version>
    <PackageTags>currency; money; CLDR; unicode; ISO 4217; ISO4217; cash rounding;</PackageTags>
    <Description>Unicode CLDR $(CldrVersion) currency data for Singulink.Globalization.Currency: every currency with localized names and symbols for all locales, rounding and cash rounding rules, and consistent behavior across all runtimes. The package version mirrors the CLDR version.</Description>
    <PackageReleaseNotes>CLDR $(CldrVersion) data, released $(CldrReleaseDate).</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/Singulink/Singulink.Globalization.Currency</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="Data\CurrencyData.bin" />
    <EmbeddedResource Include="Data\CurrencyData.bin" LogicalName="Singulink.Globalization.Currency.Cldr.CurrencyData.bin" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Singulink.Globalization.Currency.DataProviders\Singulink.Globalization.Currency.DataProviders.csproj" />
  </ItemGroup>
</Project>
