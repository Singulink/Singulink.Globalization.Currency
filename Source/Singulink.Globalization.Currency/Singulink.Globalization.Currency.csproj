<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Singulink.Globalization</RootNamespace>
    <TargetFrameworks>netstandard2.0;net8.0;net8.0-windows10.0.19041;net9.0;net9.0-windows10.0.19041;net10.0;net10.0-windows10.0.19041</TargetFrameworks>
    <NoWarn>CA1034</NoWarn>

    <Version>1.0.1</Version>
    <PackageTags>currency; money; wallet; NodaMoney; JodaMoney; ISO 4217; ISO4217;</PackageTags>
    <Description>High-performance and flexible currency support for .NET, done right 🎉</Description>
    <PackageProjectUrl>https://github.com/Singulink/Singulink.Globalization.Currency</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" />
    <PackageReference Include="Microsoft.Bcl.HashCode" />
    <PackageReference Include="PolySharp" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Singulink.Globalization.Currency.DataProviders\Singulink.Globalization.Currency.DataProviders.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Singulink.Collections" />
    <PackageReference Include="Singulink.Enums" />
    <PackageReference Include="System.Collections.Immutable" />
  </ItemGroup>
</Project>